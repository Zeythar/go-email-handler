```bash
# Example SMTP configuration. Copy to backend/.env and fill with your values.
# For Gmail SMTP (use an App Password for increased security):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
# Optional override for the From header in outgoing emails
SMTP_FROM=contact-form@example.com

# Destination for contact form emails
TO_EMAIL=your_real_target@example.com

# Server listen port (optional)
PORT=8080

# reCAPTCHA secret (required in production)
# Obtain from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your_recaptcha_secret_here
# Threshold for accepting scores (float between 0.0 and 1.0). Default in code: 0.5
RECAPTCHA_THRESHOLD=0.5

# Frontend origin allowed for CORS; set to your frontend URL in production
# e.g. https://example.com
ALLOWED_ORIGIN=

# When non-empty, backend will emit compact reCAPTCHA debug lines to logs
# Useful for diagnosing verification failures in staging/dev only
RECAPTCHA_DEBUG=

# Notes:
# - This backend uses an in-memory rate limiter. For production with multiple
#   instances, replace it with a shared store (e.g. Redis) to avoid bypasses.
# - Keep secrets out of source control. Add backend/.env to .gitignore after
#   copying values.
```
# Example SMTP configuration. Copy to .env and fill with your values.
# For Gmail SMTP (less secure apps must be enabled or use App Passwords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_smtp_password_or_app_password
TO_EMAIL=your_real_target@example.com

# Optional: change server port
PORT=8080
