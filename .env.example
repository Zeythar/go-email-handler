```bash
# Example Mailgun API configuration. Copy to backend/.env and fill with your values.
# Use Mailgun's API for sending (recommended for cloud hosts where SMTP ports
# may be blocked, and for better observability).

# Mailgun API configuration
# Provide the full Mailgun messages endpoint URL (example provided by Mailgun):
# e.g. https://api.eu.mailgun.net/v3/etheoo.com/messages
MAILGUN_API_URL=https://api.eu.mailgun.net/v3/yourdomain.com/messages
# Mailgun API key (the 'key-...' value)
MAILGUN_API_KEY=key-your-mailgun-api-key
# Default From address used for outgoing messages
MAILGUN_FROM=noreply@yourdomain.com

# Destination for contact form emails
TO_EMAIL=your_real_target@example.com

# Server listen port (optional)
PORT=8080

# reCAPTCHA secret (required in production)
# Obtain from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=your_recaptcha_secret_here
# Threshold for accepting scores (float between 0.0 and 1.0). Default in code: 0.5
RECAPTCHA_THRESHOLD=0.5

# Frontend origin allowed for CORS; set to your frontend URL (no trailing slash)
# e.g. https://example.com
ALLOWED_ORIGIN=

# When non-empty, backend will emit compact reCAPTCHA debug lines to logs
# Useful for diagnosing verification failures in staging/dev only
RECAPTCHA_DEBUG=

# Notes:
# - Mailgun requires you to verify a domain (often recommend using a subdomain
#   such as mg.yourdomain.com). Follow the DNS instructions in the Mailgun
#   dashboard (SPF, DKIM, and tracking CNAMEs) before sending to unrestricted
#   recipients. The sandbox domain restricts recipients until verification.
# - Using the Mailgun HTTP API avoids outbound SMTP port issues and provides
#   better response codes and logs.
# - Keep secrets out of source control. Add backend/.env to .gitignore after
#   copying values.
```
# Destination for contact form emails
TO_EMAIL=your_real_target@example.com

# Optional: change server port
PORT=8080
SMTP_PASS=your_smtp_password_or_app_password
